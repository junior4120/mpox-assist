# Mode du moteur IA : "demo" (par défaut) ou "real"
MPOX_AI_MODE=demo

# Chemin du modèle réel (utilisé seulement si MPOX_AI_MODE=real)
MPOX_MODEL_PATH=ml/export/model.pt

# Base de données (SQLite par défaut en dev, PostgreSQL via docker-compose)
DATABASE_URL=sqlite:///./mpox_assist.db
# Exemple PostgreSQL : postgresql://mpox_user:CHANGE_ME@db:5432/mpox_assist

# Clé API simple pour le POC (à remplacer par un vrai système d'auth en prod)
MPOX_API_KEY=poc-demo-key-change-me
